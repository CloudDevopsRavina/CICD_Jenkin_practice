pipeline {
    agent any

    stages {
        stage('Checkout Git') {
            steps {
                // Checkout into a subdirectory
                dir('Terraform') {
                    git branch: 'main', url: 'https://github.com/CloudDevopsRavina/Terraform'
                }
            }
        }
        
        stage('Terraform Init') {
            steps {
                // Run commands inside the same subdirectory
                dir('Terraform/Day-2') {
                    sh 'terraform init'
                }
            }
        }
         stage('Terraform plan') {
            steps {
                // Run commands inside the same subdirectory
                dir('Terraform/Day-2') {
                    sh 'terraform plan'
                }
            }
        }
    }
}
